  indices: {},

  pick(prompt) {
    const p = prompt.toLowerCase().trim();
    let isOverride = false;

    for (const [key, val] of Object.entries(this.overrides)) {
      if (p === key && !this.refusalSet.has(val)) {
        console.log(` override answer: "${val}"`);
        // FIX: Return the answer AND a flag that it's an override
        return { answer: val, isOverride: true };
      }
    }

 
    let cat = 'default';
    for (const [re, name] of this.rules) {
      if (re.test(p)) { cat = name; break; }
    }

   
    if (this.indices[cat] === undefined) this.indices[cat] = 0;
    const bank = this.banks[cat] ?? this.banks.default;
    const idx = this.indices[cat];
    this.indices[cat] = (idx + 1) % bank.length;
    const answer = bank[idx];
    if (this.indices[cat] === 0) {
      console.log(`  bank "${cat}" cycled through all ${bank.length} items, restarting again`);
    }
    return { answer, isOverride: false };
  },

  findInput() {
    let el = document.querySelector('input[placeholder*="answer" i], textarea[placeholder*="answer" i]');
    if (el) return { el, type: 'placeholder' };
    el = [...document.querySelectorAll('input')].find(i => (i.type === 'text' || !i.type) && i.offsetParent !== null);
    if (el) return { el, type: 'input' };
    el = document.querySelector('textarea');
    if (el && el.offsetParent !== null) return { el, type: 'textarea' };
    el = document.querySelector('[contenteditable="true"], [contenteditable=""]');
    if (el && el.offsetParent !== null) return { el, type: 'contenteditable' };
    return null;
  },

  findDiveBtn() {
    return document.querySelector('.kr-send') ||
           [...document.querySelectorAll('button')].find(b => b.textContent.trim() === 'Dive' && !b.disabled);
  },

  findPrompt() {
    return document.querySelector('.kr-prompt')?.textContent.trim() || null;
  },

  async type(el, type, answer) {
    if (type === 'contenteditable') {
      el.focus();
      el.textContent = '';
      el.dispatchEvent(new InputEvent('input', { bubbles: true, data: answer, inputType: 'insertText' }));
      await new Promise(r => setTimeout(r, 50));
      el.textContent = answer;
      el.dispatchEvent(new InputEvent('input', { bubbles: true, data: answer, inputType: 'insertText' }));
    } else {
      el.focus();
      const proto = el instanceof HTMLTextAreaElement ? HTMLTextAreaElement.prototype : HTMLInputElement.prototype;
      Object.getOwnPropertyDescriptor(proto, 'value').set.call(el, answer);
      el.dispatchEvent(new Event('input', { bubbles: true }));
      el.dispatchEvent(new Event('change', { bubbles: true }));
    }
  },

  async act() {
  
    if (!this.running || this.busy) return;
    this.busy = true;

    const prompt = this.findPrompt();
    if (!prompt || prompt.length < 5) { this.busy = false; return; }


    if (prompt !== this.lastPrompt) {
      this.lastPrompt = prompt;
      this.attempts = 0;
      this.diveCount++;
      console.log(`\ #${this.diveCount}: "${prompt}"`);
    }


    if (this.attempts >= 10000) { this.busy = false; return; }

    const found = this.findInput();
    const btn = this.findDiveBtn();
    if (!found) { this.busy = false; return; }

 
    const result = this.pick(prompt);
    const answer = result.answer;
    const isOverride = result.isOverride;
    this.attempts++;
    console.log(` trying ${this.attempts}: "${answer}"`);

  
    if (isOverride) {
      console.log('matched prompt, override is on, using for this prompt');
      await new Promise(r => setTimeout(r, 3000));
    }

    await this.type(found.el, found.type, answer);
    found.el.dispatchEvent(new KeyboardEvent('keydown', { key: 'Enter', keyCode: 13, bubbles: true }));
    found.el.dispatchEvent(new KeyboardEvent('keypress', { key: 'Enter', keyCode: 13, bubbles: true }));
    found.el.dispatchEvent(new KeyboardEvent('keyup',   { key: 'Enter', keyCode: 13, bubbles: true }));
    if (btn) btn.click();

    await new Promise(r => setTimeout(r, 1400));

    const next = this.findPrompt();
    if (next && next !== prompt) {
      this.accepted++;
      console.log(' accepted?');
    } else {
      this.refused++;
      this.refusalSet.add(answer);
      console.log(` refused? "${answer}" - trying another`);
    }

   
    this.busy = false;
  },

  start() {
    this.running = true;
    this.interval = setInterval(() => this.act(), 900);
    console.log('started.');
  },
  stop() { this.running = false; clearInterval(this.interval); console.log('stopped. still does not work? try reloading'); },
  reset() { this.diveCount = this.accepted = this.refused = this.attempts = 0; this.refusalSet.clear(); this.lastPrompt = ''; }
};

