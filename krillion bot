    const prompt = this.findPrompt();
    if (!prompt || prompt.length < 5) { this.busy = false; return; }


    if (prompt !== this.lastPrompt) {
      this.lastPrompt = prompt;
      this.attempts = 0;
      this.diveCount++;
      console.log(`\ #${this.diveCount}: "${prompt}"`);
    }


    if (this.attempts >= 10000) { this.busy = false; return; }

    const found = this.findInput();
    const btn = this.findDiveBtn();
    if (!found) { this.busy = false; return; }

 
    const result = this.pick(prompt);
    const answer = result.answer;
    const isOverride = result.isOverride;
    this.attempts++;
    console.log(` trying ${this.attempts}: "${answer}"`);

  
    if (isOverride) {
      console.log('matched prompt, override is on, using for this prompt');
    }

    await this.type(found.el, found.type, answer);
    found.el.dispatchEvent(new KeyboardEvent('keydown', { key: 'Enter', keyCode: 13, bubbles: true }));
    found.el.dispatchEvent(new KeyboardEvent('keypress', { key: 'Enter', keyCode: 13, bubbles: true }));
    found.el.dispatchEvent(new KeyboardEvent('keyup',   { key: 'Enter', keyCode: 13, bubbles: true }));
    if (btn) btn.click();

    await new Promise(r => setTimeout(r, 1400));

    const next = this.findPrompt();
    if (next && next !== prompt) {
      this.accepted++;
      console.log(' accepted?');
    } else {
      this.refused++;
      this.refusalSet.add(answer);
      console.log(` refused? "${answer}" - trying another`);
    }

   
    this.busy = false;
  },

  start() {
    this.running = true;
    this.interval = setInterval(() => this.act(), 900);
    console.log('started.');
  },
  stop() { this.running = false; clearInterval(this.interval); console.log('stopped. still does not work? try reloading'); },
  reset() { this.diveCount = this.accepted = this.refused = this.attempts = 0; this.refusalSet.clear(); this.lastPrompt = ''; }
};

window.K = K;
K.start();
